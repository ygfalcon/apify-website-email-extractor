{ "title": "Contact extractor input", "type": "object", "schemaVersion": 1, "properties": {
  "urls": { "title": "Websites or domains", "type": "array", "editor": "stringList", "description": "One per line. Domains (example.com) or URLs. Duplicates are removed.", "prefill": ["apify.com", "stripe.com"] },
  "maxPagesPerDomain": { "title": "Max pages per domain", "type": "integer", "minimum": 1, "maximum": 10, "default": 4, "description": "Home page plus contact/about/impressum pages." },
  "concurrency": { "title": "Parallel domains", "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
  "chargeOnlyHits": { "title": "Only charge for domains with contacts", "type": "boolean", "default": true, "editor": "hidden" },
  "proxyConfiguration": { "title": "Proxy", "type": "object", "editor": "proxy", "prefill": { "useApifyProxy": false }, "default": { "useApifyProxy": false } }
}, "required": ["urls"] }
